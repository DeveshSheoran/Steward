# Copy to .env and fill in. .env is git-ignored.

# ---- Which LLM backend? (STEWARD_LLM) ----
#   anthropic   : Anthropic API key (production / evaluators)            -> needs ANTHROPIC_API_KEY
#   claude_code : YOUR OWN Claude plan through the `claude` CLI (personal local dev/demo only)
#   gemini | groq | openrouter | ollama : OpenAI-compatible endpoints (free tiers exist)
STEWARD_LLM=claude_code
# ANTHROPIC_API_KEY=sk-ant-...           # only for STEWARD_LLM=anthropic (ignored/stripped for claude_code)
# STEWARD_CLAUDE_MODEL=sonnet            # optional, claude_code backend (alias or full model name)
# STEWARD_CLAUDE_BIN=claude              # optional path to the CLI

# Example free-tier fallback:
# STEWARD_LLM=gemini
# GEMINI_API_KEY=...
# STEWARD_OPENAI_MODEL=gemini-2.5-flash
# STEWARD_LLM_MIN_INTERVAL_S=4           # spacing between calls to stay under free-tier rate limits

# ---- Browser ----
# Use the installed Google Chrome (needed on Ubuntu 20.04, where Playwright's bundled Chromium is unsupported).
STEWARD_BROWSER_CHANNEL=chrome
# STEWARD_HEADLESS=0        # set to 0 to watch the browser (good for the demo video)
# STEWARD_MODEL=claude-sonnet-5-5       # model name for the anthropic backend
